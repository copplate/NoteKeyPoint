<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.exaiio.secondproject.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />

        <action
            android:id="@+id/action_FirstFragment_to_NoteFragment"
            app:destination="@id/NoteFragmentOne" />
        <action
            android:id="@+id/action_FirstFragment_to_NoteFragmentTwo"
            app:destination="@id/NoteFragmentTwo" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.exaiio.secondproject.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>
    <fragment
        android:id="@+id/NoteFragmentOne"
        android:name="com.exaiio.secondproject.fragment.NoteFragmentOne"
        android:label="@string/note_fragment_one_label"
        >
    </fragment>

    <fragment
        android:id="@+id/NoteFragmentTwo"
        android:name="com.exaiio.secondproject.fragment.NoteFragmentTwo"
        android:label="@string/note_fragment_two_label"
        >
    </fragment>
</navigation>